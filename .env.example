# Local development
PORT=5000
ADMIN_ID=admin
ADMIN_PASSWORD=CHANGE_THIS_BEFORE_LIVE
ADMIN_NAME=SNDF Admin

# Railway Volume (Railway normally sets RAILWAY_VOLUME_MOUNT_PATH automatically)
# If you prefer a manual variable, set: DB_DIR=/app/data

# Optional GPS geofence (leave blank to capture GPS without blocking check-in)
LOC_01_LAT=
LOC_01_LNG=
LOC_02_LAT=
LOC_02_LNG=
LOC_03_LAT=
LOC_03_LNG=
GEOFENCE_RADIUS_METERS=200
